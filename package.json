{
  "name": "peakwright-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "compat/*"
  ],
  "packageManager": "bun@1.3.1",
  "scripts": {
    "build": "bun run --cwd packages/core build && bun run --cwd packages/node build && bun run --cwd packages/web build && bun run --cwd packages/cli build",
    "check": "biome check . && bun run build",
    "format": "biome check --write .",
    "test": "bun run build && bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}
