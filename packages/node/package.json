{
  "name": "@peakwright/node",
  "version": "1.0.0",
  "description": "Lightweight waveform generation for Node.js and Bun with native WAV support.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@peakwright/core": "^1.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "bun run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t4nz/ffmpeg-peaks.git",
    "directory": "packages/node"
  },
  "keywords": [
    "audio",
    "bun",
    "ffmpeg",
    "nodejs",
    "waveform",
    "wav"
  ],
  "author": "Gaetano Fiorello",
  "license": "MIT"
}
