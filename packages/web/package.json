{
  "name": "@peakwright/web",
  "version": "1.0.0",
  "description": "Zero-dependency WAV waveform generation for browsers and web runtimes.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
